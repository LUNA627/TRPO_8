<Page x:Class="TRPO_8.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_8.Pages"
      xmlns:validators="clr-namespace:TRPO_8.Validation"
      mc:Ignorable="d" 
      Background="{DynamicResource WindowBackground}"
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="LoginPage">

    <Grid>
        <StackPanel Style="{DynamicResource StackPanelStyle}">
            <Label Style="{DynamicResource LabelStyleTitul}" Content="Вход"/>
        </StackPanel>

        <StackPanel Style="{DynamicResource StackPanelOrientationHorizontal}">
            <StackPanel>
                <Label Style="{DynamicResource LabelStyle}" Content="Идентификатор"/>
                <Label Style="{DynamicResource LabelStyle}" Content="Пароль"/>
            </StackPanel>

            <StackPanel>
                <TextBox Name="IdTextBox" Style="{DynamicResource TextBoxStyle}" MaxLength="5">
                    <TextBox.Text>
                        <Binding Path="DoctorId" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validators:IsEmptyRule/>
                                <validators:IsOnlyNumRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <ItemsControl Foreground="Red"
                              FontSize="12" 
                              ItemsSource="{Binding ElementName=IdTextBox, Path=(Validation.Errors)}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                
                <TextBox Name="PasswordTextBox" Style="{DynamicResource TextBoxStyle}">
                    <TextBox.Text>
                        <Binding Path="Password" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validators:IsEmptyRule/>
                                <validators:CountSimvolRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <ItemsControl Foreground="Red"
              FontSize="12" 
              ItemsSource="{Binding ElementName=PasswordTextBox, Path=(Validation.Errors)}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>



                <StackPanel Style="{DynamicResource StackPanelOrientationHorizontalRight}">
                    <Button Style="{DynamicResource LoginButtonEnterStyle}" Click="LoginDoctor_Click"/>
                    <Button Style="{DynamicResource LoginButtonRegStyle}" Click="RegistrationDoctor_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
