<Page x:Class="TRPO_8.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage">
    <DockPanel LastChildFill="False">

        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
            <Label Content="Регистрация" FontSize="22"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Label Content="Фамилия" HorizontalAlignment="Left" VerticalAlignment="Center"  />
                <Label Content="Имя"  HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Label Content="Отчество"  HorizontalAlignment="Left" VerticalAlignment="Center"  />
                <Label Content="Профессия"  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label Content="Пароль" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label Content="Подтверждение пароля" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel>
                <TextBox Text="{Binding _Name}" Margin="0,5,15,0" VerticalAlignment="Center"  HorizontalAlignment="Left" Width="350"/>
                <TextBox Text="{Binding _LastName}" Margin="0,10,15,0"  HorizontalAlignment="Left" Width="350"/>
                <TextBox Text="{Binding _MiddleName}" Margin="0,10,15,0"   HorizontalAlignment="Left" Width="350"/>
                <TextBox Text="{Binding _Specialisation}"  Margin="0,5,15,0"   HorizontalAlignment="Left" Width="350"/>
                <TextBox Text="{Binding _Password}" HorizontalAlignment="Left" Width="350" VerticalAlignment="Center"  Margin="0, 5, 15, 5"/>
                <TextBox Text="{Binding _RepeatPassword}" HorizontalAlignment="Left" Width="350" Margin="0, 5, 15, 5"/>
                <Button Content="Сохранить" VerticalAlignment="Top" HorizontalAlignment="Right" Height="30" Width="110" Margin="0, 5, 20, 0" Click="SaveNewDoctor_Click" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Page>
