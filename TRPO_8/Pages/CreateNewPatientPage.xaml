<Page x:Class="TRPO_8.Pages.CreateNewPatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreateNewPatientPage">


    <DockPanel LastChildFill="False">

        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
            <Label Content="Регистрация пациента" FontSize="22"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Label Content="Фамилия" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0, 5, 15, 0"/>
                <Label Content="Имя"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0, 0, 15, 0"/>
                <Label Content="Отчество"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0, 0, 15, 0" />
                <Label Content="День рождения"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0, 0, 15, 0"/>
                <Label Content="Контактный телефон" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0, 5, 15, 0"/>
            </StackPanel>

            <StackPanel>
                <TextBox Text="{Binding NamePatient, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,15,0" VerticalAlignment="Center"  HorizontalAlignment="Left" Width="350"/>
                <TextBox Text="{Binding LastNamePatient, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,15,0"  HorizontalAlignment="Left" Width="350"/>
                <TextBox Text="{Binding MiddleNamePatient, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,15,0"   HorizontalAlignment="Left" Width="350"/>
                <TextBox Text="{Binding BirthdayPatient, UpdateSourceTrigger=PropertyChanged}"  Margin="0,5,15,0"   HorizontalAlignment="Left" Width="350"/>
                <TextBox Text="{Binding PhonePatient, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="350" Margin="0, 5, 15, 5"/>
                <Button Content="Сохранить" VerticalAlignment="Top" HorizontalAlignment="Right" Height="30" Width="110" Margin="0, 5, 20, 0" Click="SaveNewPatint_Click" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Page>
