<Page x:Class="TRPO_8.Pages.CreateNewPatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:validators="clr-namespace:TRPO_8.Validation"
      xmlns:local="clr-namespace:TRPO_8.Pages"
      mc:Ignorable="d" 
      Background="{DynamicResource WindowBackground}"
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="CreateNewPatientPage">


    <Grid>
        <!-- Заголовок -->
        <StackPanel Style="{DynamicResource StackPanelStyle}">
            <Label Style="{DynamicResource LabelStyleTitul}" Content="Регистрация пациента"/>
        </StackPanel>

        <!-- Форма -->
        <Grid Style="{DynamicResource GridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Фамилия -->
            <Label Grid.Row="0" Grid.Column="0" Style="{DynamicResource LabelStyle}" Content="Фамилия" />
            <TextBox Grid.Row="0" Grid.Column="1" Name="LastNameTextBox" Style="{DynamicResource TextBoxStyle}">
                <TextBox.Text>
                    <Binding Path="LastNamePatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:IsOnlyCharsRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="1" Grid.Column="1" Foreground="Red" FontSize="12"
                          ItemsSource="{Binding ElementName=LastNameTextBox, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Имя -->
            <Label Grid.Row="2" Grid.Column="0" Style="{DynamicResource LabelStyle}" Content="Имя"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="NameTextBox" Style="{DynamicResource TextBoxStyle}" >
                <TextBox.Text>
                    <Binding Path="NamePatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:IsOnlyCharsRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="3" Grid.Column="1" Foreground="Red" FontSize="12"
                          ItemsSource="{Binding ElementName=NameTextBox, Path=(Validation.Errors)}" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Отчество -->
            <Label Grid.Row="4" Grid.Column="0" Style="{DynamicResource LabelStyle}" Content="Отчество"/>
            <TextBox Grid.Row="4" Grid.Column="1" Name="MiddleNameTextBox" Style="{DynamicResource TextBoxStyle}" >
                <TextBox.Text>
                    <Binding Path="MiddleNamePatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:IsOnlyCharsRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="5" Grid.Column="1" Foreground="Red" FontSize="12"
                          ItemsSource="{Binding ElementName=MiddleNameTextBox, Path=(Validation.Errors)}" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- День рождения -->
            <Label Grid.Row="6" Grid.Column="0" Style="{DynamicResource LabelStyle}" Content="День рождения" />
            <DatePicker Grid.Row="6" Grid.Column="1" Name="BirthdayTextBox" Style="{DynamicResource DatePickerStyle}" SelectedDate="{Binding BirthdayPatient}">
                <DatePicker.Text>
                    <Binding Path="BirthdayPatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:DateTimeRole/>
                        </Binding.ValidationRules>
                    </Binding>
                </DatePicker.Text>
            </DatePicker>
            <ItemsControl Grid.Row="7" Grid.Column="1" Foreground="Red" FontSize="12"
                          ItemsSource="{Binding ElementName=BirthdayTextBox, Path=(Validation.Errors)}" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Телефон -->
            <Label Grid.Row="8" Grid.Column="0" Style="{DynamicResource LabelStyle}" Content="Контактный телефон" />
            <TextBox Grid.Row="8" Grid.Column="1" Name="PhoneTextBox" Style="{DynamicResource TextBoxStyle}" >
                <TextBox.Text>
                    <Binding Path="PhonePatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="9" Grid.Column="1" Foreground="Red" FontSize="12"
                          ItemsSource="{Binding ElementName=PhoneTextBox, Path=(Validation.Errors)}" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Кнопки -->
            <StackPanel Grid.Row="10" Grid.Column="1" Style="{DynamicResource StackPanelOrientationHorizontalRight}" >
                <Button Style="{DynamicResource SaveButtonStyle}" Click="SaveNewPatint_Click" />
                <Button Style="{DynamicResource BackButtonStyle}" Click="GoBack_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
