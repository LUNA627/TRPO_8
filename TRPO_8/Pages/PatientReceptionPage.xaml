<Page x:Class="TRPO_8.Pages.PatientReceptionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_8.Pages"
      xmlns:validators="clr-namespace:TRPO_8.Validation"
      xmlns:classs="clr-namespace:TRPO_8.Classs"
      xmlns:converters="clr-namespace:TRPO_8.Convertes"
      d:DataContext="{d:DesignInstance Type=classs:Patient}"
      Background="{DynamicResource MaterialDesignBackground}"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1000"
      Title="PatientReceptionPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Style="{DynamicResource StackPanelOrientationHorizontal}">
            <Button Style="{StaticResource ButtonStyle}" Content="Назад" Click="GoBackPatient_Click" />
            <Button Style="{StaticResource ButtonStyle}" Content="Изменить" Click="ChangePatient_Click"/>
        </StackPanel>
        <ListView Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView Grid.Row="1" Grid.RowSpan="3" ItemsSource="{Binding Patient.AppointmentStories}" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Последний доктор: "/>
                            <TextBlock Text="{Binding DoctorId}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Диагноз: "/>
                            <TextBlock Text="{Binding Diagnosis}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Рекомендации: "/>
                            <TextBlock Text="{Binding Recomendations}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Label Style="{StaticResource LabelStyleTitul}" Content="Текущая информация о пациенте: " Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"/>
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.RowSpan="3">
            <Label Style="{StaticResource LabelStyleReceptionPage}" Content="Имя:"/>
            <Label Style="{StaticResource LabelStyleReceptionPage}" Content="Фамилия:"/>
            <Label Style="{StaticResource LabelStyleReceptionPage}" Content="Отчество:"/>
            <Label Style="{StaticResource LabelStyleReceptionPage}" Content="Дата рождения:"/>
            <Label Style="{StaticResource LabelStyleReceptionPage}" Content="Телефон:"/>
            <Label Style="{StaticResource LabelStyleReceptionPage}" Content="Последний прим:"/>

        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="3">
            <TextBox Style="{StaticResource RoundedTextBoxStyleReceptionPage}" Text="{Binding Patient.NamePatient}"/>
            <TextBox Style="{DynamicResource RoundedTextBoxStyleReceptionPage}" Text="{Binding Patient.LastNamePatient}"/>
            <TextBox Style="{DynamicResource RoundedTextBoxStyleReceptionPage}" Text="{Binding Patient.MiddleNamePatient}"/>
            <TextBox Style="{DynamicResource RoundedTextBoxStyleReceptionPage}" Text="{Binding Patient.BirthdayPatient, StringFormat={}{0:dd.MM.yyyy}}"/>
            <TextBox Style="{DynamicResource RoundedTextBoxStyleReceptionPage}" Text="{Binding Patient.PhonePatient}"/>
            <TextBlock Style="{StaticResource TextBlockStyleReceptionPage}" Text="{Binding Patient.AppointmentStories, Converter={StaticResource DayAppointmentConverter}}"/>

        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="3" Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="0, 40,0,0">
            <Label Style="{StaticResource LabelStyleReceptionPage}" Content="Последний врач:"/>
            <TextBox Style="{StaticResource RoundedTextBoxStyleReceptionPageP}" Text="{Binding CurrentDoctorId}" IsReadOnly="True"/>
            <Label Style="{StaticResource LabelStyleReceptionPage}" Content="Диагноз:"/>

            <TextBox Style="{DynamicResource RoundedTextBoxStyleReceptionPageP}" Name="DiagnosisTextBox">
                <TextBox.Text>
                    <Binding Path="CurrentAppointment.Diagnosis" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="1" Grid.Column="1" Foreground="Red" FontSize="12"
               ItemsSource="{Binding ElementName=DiagnosisTextBox, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Style="{DynamicResource LabelStyleReceptionPage}" Content="Рекомендации:"/>
            <TextBox  Name="RecomendationsTextBox" Style="{DynamicResource RoundedTextBoxStyleReceptionPageP}">
                <Binding Path="CurrentAppointment.Recomendations" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:IsEmptyRule/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <ItemsControl Grid.Row="1" Grid.Column="1" Foreground="Red" FontSize="12"
                   ItemsSource="{Binding ElementName=DiagnosisTextBox, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Button Style="{DynamicResource ButtonStyleReceptionPage}" Content="Сохранить" Click="SaveAppointment_Click"/>
        </StackPanel>
    </Grid>
</Page>
