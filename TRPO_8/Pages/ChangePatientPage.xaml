<Page x:Class="TRPO_8.Pages.ChangePatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:validators="clr-namespace:TRPO_8.Validation"
      xmlns:local="clr-namespace:TRPO_8.Pages"
      Background="{DynamicResource MaterialDesignBackground}"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1100"
      Title="ChangePatientPage">

    <Grid>
 
        <StackPanel Style="{DynamicResource StackPanelStyle}">
            <Label Content="Изменение информации пациента" Style="{StaticResource LabelStyleTitul}"/>
        </StackPanel>

 
        <Grid Style="{DynamicResource GridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyleChangePage}" Content="Имя:" />
            <TextBox Grid.Row="0" Grid.Column="1" Name="LastNameTextBox" Style="{StaticResource RoundedTextBoxStyleChangePage}">
                <TextBox.Text>
                    <Binding Path="Patient.LastNamePatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:IsOnlyCharsRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="1" Grid.Column="1" Foreground="{StaticResource ValidationErrorForeground}" FontSize="12"
                ItemsSource="{Binding ElementName=LastNameTextBox, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyleChangePage}" Content="Фамилия:" />
            <TextBox Grid.Row="2" Grid.Column="1" Name="NameTextBox" Style="{StaticResource RoundedTextBoxStyleChangePage}">
                <TextBox.Text>
                    <Binding Path="Patient.NamePatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:IsOnlyCharsRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="3" Grid.Column="1" Foreground="{StaticResource ValidationErrorForeground}" FontSize="12"
                ItemsSource="{Binding ElementName=NameTextBox, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyleChangePage}" Content="Отчество:" />
            <TextBox Grid.Row="4" Grid.Column="1" Name="MiddleNameTextBox" Style="{StaticResource RoundedTextBoxStyleChangePage}">
                <TextBox.Text>
                    <Binding Path="Patient.MiddleNamePatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:IsOnlyCharsRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="5" Grid.Column="1" Foreground="{StaticResource ValidationErrorForeground}" FontSize="12"
                ItemsSource="{Binding ElementName=MiddleNameTextBox, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelStyleChangePage}" Content="Дата рождения:" />
            <DatePicker Grid.Row="6" Grid.Column="1" Name="BirthdayTextBox" Style="{DynamicResource DatePickerStyleLong}">
                <DatePicker.SelectedDate>
                    <Binding Path="Patient.BirthdayPatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:DateTimeRole/>
                        </Binding.ValidationRules>
                    </Binding>
                </DatePicker.SelectedDate>
            </DatePicker>
            <ItemsControl Grid.Row="7" Grid.Column="1" Foreground="{StaticResource ValidationErrorForeground}" FontSize="12"
                ItemsSource="{Binding ElementName=BirthdayTextBox, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Label Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelStyleChangePage}" Content="Номер телефона:"/>
            <TextBox Grid.Row="8" Grid.Column="1" Name="PhoneTextBox" Style="{StaticResource RoundedTextBoxStyleChangePage}">
                <TextBox.Text>
                    <Binding Path="Patient.PhonePatient" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:IsEmptyRule/>
                            <validators:PhoneNumberRole/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ItemsControl Grid.Row="9" Grid.Column="1" Foreground="{StaticResource ValidationErrorForeground}" FontSize="12"
                ItemsSource="{Binding ElementName=PhoneTextBox, Path=(Validation.Errors)}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ErrorContent}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <StackPanel Grid.Row="10" Grid.Column="1" Style="{DynamicResource StackPanelOrientationHorizontalRight}">
                <Button Style="{StaticResource ButtonStyle}" Content="Изменить" Click="Save_Click"/>
                <Button Style="{StaticResource ButtonStyle}" Content="Назад" Click="GoBack_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
