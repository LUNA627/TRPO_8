<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Стиль для DatePicker -->
    <Style x:Key="RoundedDatePickerStyle" TargetType="DatePicker">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="930"/>
        <Setter Property="Background" Value="{DynamicResource MaterialDesignTextFieldBoxBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
        <!-- Шаблон -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">

                        <!-- Поле ввода -->
                        <Grid>
                            <TextBox x:Name="PART_TextBox"
                                     Text="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:dd.MM.yyyy}}"
                                     Foreground="{TemplateBinding Foreground}"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     Padding="10,0"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     IsReadOnly="True"
                                     FontSize="{TemplateBinding FontSize}"
                                     VerticalContentAlignment="Center"/>

                            <!-- Кнопка календаря -->
                            <Button x:Name="PART_Button"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Cursor="Hand">
                                <Image Source="/Images/calendar.png" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ValidationErrorBackground}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ValidationErrorBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>