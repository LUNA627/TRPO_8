<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="PatientListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="20"/>
                    <Setter Property="Margin" Value="0,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <materialDesign:Card 
                                    Margin="0"
                                    Padding="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    UniformCornerRadius="8"
                                    SnapsToDevicePixels="True">

                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding FullName}" 
                                               Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignHeadline}"/>

                                        <TextBlock Margin="0,8,0,0">
                                        <Run Text="Телефон:" FontWeight="SemiBold"/>
                                        <Run Text="{Binding PhonePatient}"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,4,0,0">
                                        <Run Text="Дата рождения:" FontWeight="SemiBold"/>
                                        <Run Text="{Binding BirthdayPatient, StringFormat={}{0:dd.MM.yyyy}}"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,4,0,0">
                                        <Run Text="Возраст:" FontWeight="SemiBold"/>
                                        <Run Text="{Binding BirthdayPatient, Converter={StaticResource AgeConverter}}"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,4,0,0">
                                        <Run Text="Статус:" FontWeight="SemiBold"/>
                                        <Run Text="{Binding BirthdayPatient, Converter={StaticResource AdultStatusConverter}}"/>
                                        </TextBlock>

                                        <TextBlock Margin="0,4,0,0">
                                        <Run Text="Приёмов:" FontWeight="SemiBold"/>
                                        <Run Text="{Binding AppointmentStories.Count}"/>
                                        </TextBlock>

                                    </StackPanel>
                                </materialDesign:Card>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>