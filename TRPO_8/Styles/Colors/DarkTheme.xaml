<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="Black"/>
    <SolidColorBrush x:Key="TextForeground" Color="White"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="Black"/>
    <SolidColorBrush x:Key="ButtonTextForeground" Color="Black"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#004578"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#378CE0"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#1E4E91"/>

    <SolidColorBrush x:Key="TextBoxBackground" Color="Black"/>
    <SolidColorBrush x:Key="TextBoxForeground" Color="#004578"/>

    <SolidColorBrush x:Key="DatePickerBackground" Color="Black"/>
    <SolidColorBrush x:Key="DatePickerForeground" Color="#004578"/>
</ResourceDictionary>