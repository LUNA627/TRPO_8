<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="White"/>
    <SolidColorBrush x:Key="TextForeground" Color="Black"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="White"/>
    <SolidColorBrush x:Key="ButtonTextForeground" Color="White"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#004578"/>
    <SolidColorBrush x:Key="ButtonHover" Color="#005A9E"/>
    <SolidColorBrush x:Key="ButtonPressed" Color="#004578"/>


    <SolidColorBrush x:Key="TextBoxBackground" Color="White"/>
    <SolidColorBrush x:Key="TextBoxForeground" Color="#005A9E"/>

    <SolidColorBrush x:Key="DatePickerBackground" Color="White"/>
    <SolidColorBrush x:Key="DatePickerForeground" Color="#005A9E"/>
</ResourceDictionary>